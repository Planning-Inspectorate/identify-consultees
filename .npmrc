# Match Azure Pipelines (node_script.yml → Node 22.23.2 ships npm 10.9.8).
# See AGENTS.md “Node and npm toolchain”.
engine-strict=true
fund=false
audit=false
# Must match Azure (default). A user-global legacy-peer-deps=true hides preact peer
# conflicts that break `npm ci` in CI (accessible-autocomplete ^8 vs Defra map ^10).
legacy-peer-deps=false
