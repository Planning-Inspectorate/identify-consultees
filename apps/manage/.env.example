ENVIRONMENT=dev

# the log level for pino
LOG_LEVEL=debug

# Authentication
AUTH_DISABLED=false
## Only required if AUTH_DISABLED=false
APP_HOSTNAME=localhost:8090
AUTH_CLIENT_ID=<populate-client-id>
AUTH_GROUP_APPLICATION_ACCESS=<populate-entra-group-for-app-access>
# Optional: group for the /admin pages (blob upload, reference-data imports). Unset = denied for everyone.
# AUTH_GROUP_ADMIN=<populate-entra-group-for-admin-pages>
AUTH_TENANT_ID='5878df98-6f88-48ab-9322-998ce557088d'
AUTH_CLIENT_SECRET=<populate-client-secret>

# a secret used for sessions
SESSION_SECRET=not-a-real-secret
SQL_CONNECTION_STRING=<populate-SQL-connection-string>

# see apps/function-python - in Azure this is set by infrastructure/app-web.tf; for local
# development, point it at wherever you're running that function (Azure Functions Core Tools default below)
PYTHON_FUNCTION_URL=http://localhost:7071/api/consultee-areas

# Shared x-api-key secret for the Python function's data routes (Key Vault-wired in Azure). The
# function runs the consultee intersection logic (POST /api/run-ruleset, resolved next to the URL
# above). `npm start` sets this to match the function's CONSULTEE_AREAS_API_KEY.
# PYTHON_FUNCTION_API_KEY=

# Optional: the app's blob storage container, enabling /admin/upload-to-blob and
# /admin/import-reference-data (Entra/managed-identity auth - no connection string).
# BLOB_STORE_HOST=https://<account>.blob.core.windows.net
# BLOB_STORE_CONTAINER=data

# Optional: Azure Managed Redis for sessions (in-memory sessions are used when unset)
# MANAGED_REDIS_URL=

# Optional: mount the prototype/debug pages (/items, /map-layers-demo, /components,
# /consultee-areas-python, /consultee-areas-direct) when NODE_ENV=production - for reviewing
# component examples on a deployed environment. Always on when NODE_ENV!=production.
# ENABLE_DEV_PAGES=true
