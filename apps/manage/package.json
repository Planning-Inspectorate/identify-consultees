{
  "name": "identify-consultees-manage",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/run-dev.mjs",
    "build": "node src/util/build.ts",
    "start": "node src/server.ts",
    "test": "node --test",
    "test:unit": "node --test",
    "test:coverage": "node scripts/run-frontend-coverage.mjs",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test --project=chromium-e2e --project=chromium-a11y --project=firefox-render --project=webkit-render",
    "test:visual": "npm run build && playwright test --project=chromium-visual",
    "test:visual:update": "npm run build && playwright test --project=chromium-visual --update-snapshots",
    "playwright:install": "node scripts/playwright-install.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "*",
    "@azure/msal-node": "*",
    "@azure/service-bus": "^7.10.0",
    "@azure/storage-blob": "*",
    "@defra/interactive-map": "*",
    "@pins/identify-consultees-database": "^0.0.0",
    "@planning-inspectorate/core": "*",
    "accessible-autocomplete": "*",
    "body-parser": "*",
    "connect-redis": "*",
    "express": "*",
    "express-rate-limit": "*",
    "express-session": "*",
    "fflate": "^0.8.3",
    "govuk-frontend": "*",
    "helmet": "*",
    "js-yaml": "^5.4.3",
    "multer": "*",
    "nunjucks": "*",
    "pdfkit": "^0.20.2",
    "pino": "*",
    "pino-pretty": "*",
    "redis": "*",
    "sharp": "*",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/multer": "*",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "*",
    "sass": "*"
  },
  "imports": {
    "#service": "./src/app/service.ts",
    "#util/*": "./src/util/*"
  }
}
