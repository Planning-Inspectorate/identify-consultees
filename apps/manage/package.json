{
  "name": "identify-consultees-manage",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/run-dev.mjs",
    "build": "node src/util/build.ts",
    "start": "node src/server.ts",
    "test": "node --test",
    "test:unit": "node --test",
    "test:coverage": "node scripts/run-frontend-coverage.mjs",
    "test:e2e": "playwright test --project=chromium-e2e --project=chromium-a11y --project=firefox-render --project=webkit-render",
    "test:visual": "playwright test --project=chromium-visual",
    "test:visual:update": "playwright test --project=chromium-visual --update-snapshots",
    "playwright:install": "playwright install --with-deps chromium firefox webkit"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "*",
    "@defra/interactive-map": "*",
    "@microsoft/microsoft-graph-client": "*",
    "@pins/identify-consultees-database": "^0.0.0",
    "@pins/identify-consultees-lib": "^0.0.0",
    "@planning-inspectorate/core": "*",
    "accessible-autocomplete": "*",
    "body-parser": "*",
    "connect-redis": "*",
    "express": "*",
    "express-session": "*",
    "express-validator": "*",
    "govuk-frontend": "*",
    "helmet": "*",
    "nunjucks": "*",
    "pino": "*",
    "pino-pretty": "*",
    "redis": "*"
  },
  "devDependencies": {
    "nodemon": "*",
    "sass": "*"
  },
  "imports": {
    "#service": "./src/app/service.ts",
    "#util/*": "./src/util/*"
  }
}
