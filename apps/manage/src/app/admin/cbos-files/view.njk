{% extends "admin/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block pageTitle %}
	{{ pageHeading }} - Admin - {{ config.headerTitle }}
{% endblock %}

{% block adminContent %}
	<h1 class="govuk-heading-l">{{ pageHeading }}</h1>

	<p class="govuk-body">
		Internal tool for debugging the import from CBOS. Lists every version of every file in CBOS's
		"GIS Shapefiles" folders, and any GeoJSON filed elsewhere, as CBOS's database records them -
		with where each is kept in its document storage, and whether the import reads it. The import
		reads only each document's newest GeoJSON version: the one CBOS made from an uploaded
		shapefile ZIP, or loaded by its historical boundaries migration.
	</p>

	{% if error %}
		{{ govukErrorMessage({ text: error }) }}
	{% endif %}

	{% if summary %}
		<h2 class="govuk-heading-m">Cases</h2>
		{{ govukSummaryList({
			rows: [
				{ key: { text: "With a case reference" }, value: { text: summary.casesWithReference } },
				{ key: { text: "With a GIS Shapefiles folder" }, value: { text: summary.casesWithGisFolder } },
				{ key: { text: "With files in it" }, value: { text: summary.casesWithFilesInGisFolder } },
				{ key: { text: "The import reads" }, value: { text: summary.casesTheImportReads } },
				{ key: { text: "With only ZIPs CBOS hasn't converted" }, value: { text: summary.casesWithOnlyUnconvertedZips } },
				{ key: { text: "With GeoJSON in another folder" }, value: { text: summary.casesWithGeoJsonElsewhere } }
			]
		}) }}

		{% if summary.unconvertedZipsByStatus | length %}
			<h2 class="govuk-heading-m">ZIPs CBOS hasn't converted</h2>
			<p class="govuk-body">
				By the status of the ZIP's latest version: <code>invalid</code> means CBOS couldn't convert
				it; <code>awaiting_upload</code>, <code>not_checked</code> or <code>awaiting_virus_check</code>
				mean it was never virus checked, so never sent for conversion.
			</p>
			{% set statusRows = [] %}
			{% for row in summary.unconvertedZipsByStatus %}
				{% set statusRows = (statusRows.push([{ html: '<code>' ~ (row.status | escape) ~ '</code>' }, { text: row.documents, format: "numeric" }]), statusRows) %}
			{% endfor %}
			{{ govukTable({
				caption: "ZIPs CBOS hasn't converted, by status",
				captionClasses: "govuk-visually-hidden",
				head: [{ text: "Status" }, { text: "ZIPs", format: "numeric" }],
				rows: statusRows
			}) }}
		{% endif %}
	{% endif %}

	<h2 class="govuk-heading-m">Files</h2>
	<form method="get" action="/admin/cbos-files" class="pins-inline-search">
		<div class="pins-inline-search__field">
			{{ govukInput({
				id: "case",
				name: "case",
				label: { text: "Case reference or title contains" },
				value: search,
				classes: "pins-inline-search__input",
				spellcheck: false
			}) }}
		</div>
		<div class="pins-inline-search__field">
			{{ govukSelect({
				id: "show",
				name: "show",
				label: { text: "Show" },
				value: show,
				items: [
					{ value: "all", text: "Every file" },
					{ value: "read", text: "Files the import reads" },
					{ value: "not-read", text: "Files the import doesn't read" }
				]
			}) }}
		</div>
		{{ govukButton({ text: "Filter", classes: "govuk-button--secondary pins-inline-search__button" }) }}
	</form>

	{% if showing %}
		<p class="govuk-body" role="status">{{ showing }}</p>
	{% endif %}

	{% if rows | length %}
		{% set tableRows = [] %}
		{% for row in rows %}
			{% set fileHtml %}
				<a class="govuk-link" href="{{ row.href }}">{{ row.fileName }}</a>
				{% if row.otherFolder %}<br><span class="govuk-hint govuk-!-font-size-16">In {{ row.otherFolder }}</span>{% endif %}
				{% if row.blobPath %}<br><code class="pins-admin-path">{{ row.blobPath }}</code>{% endif %}
			{% endset %}
			{% set tableRows = (tableRows.push([
				{ html: (row.caseReference | escape) ~ '<br><span class="govuk-hint govuk-!-font-size-16">' ~ (row.caseTitle | escape) ~ '</span>' },
				{ html: fileHtml },
				{ text: row.version },
				{ text: row.type },
				{ text: row.status },
				{ text: row.created },
				{ html: govukTag({ text: "Read", classes: "govuk-tag--green" }) if row.readByImport else "" }
			]), tableRows) %}
		{% endfor %}
		<div class="pins-admin-scroll" role="region" aria-label="CBOS files" tabindex="0">
			{{ govukTable({
				caption: "CBOS files",
				captionClasses: "govuk-visually-hidden",
				classes: "pins-admin-files",
				head: [
					{ text: "Case" },
					{ text: "File and blob path" },
					{ text: "Version" },
					{ text: "Type" },
					{ text: "Status" },
					{ text: "Created" },
					{ text: "Import" }
				],
				rows: tableRows
			}) }}
		</div>
	{% endif %}
{% endblock %}
