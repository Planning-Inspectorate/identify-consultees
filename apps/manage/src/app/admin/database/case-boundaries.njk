{% extends "admin/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{{ pageHeading }} - Admin - {{ config.headerTitle }}
{% endblock %}

{% block adminContent %}
	<h1 class="govuk-heading-l"><span class="govuk-caption-l">Database</span>{{ pageHeading }}</h1>

	<form method="get" action="/admin/database/case-boundaries" class="pins-inline-search">
		<div class="pins-inline-search__field">
			{{ govukInput({
				id: "q",
				name: "q",
				label: { text: "Case reference or name contains" },
				value: search,
				classes: "pins-inline-search__input",
				spellcheck: false
			}) }}
		</div>
		{{ govukButton({ text: "Filter", classes: "govuk-button--secondary pins-inline-search__button" }) }}
	</form>

	<p class="govuk-body" role="status">{{ showing }}</p>

	{% if rows | length %}
		{% set tableRows = [] %}
		{% for row in rows %}
			{% set tableRows = (tableRows.push([
				{ html: '<a class="govuk-link" href="' ~ row.href ~ '">' ~ (row.caseReference | escape) ~ '</a>' },
				{ text: row.caseName },
				{ text: row.fileName },
				{ text: row.receivedDate },
				{ text: row.geometryType }
			]), tableRows) %}
		{% endfor %}
		{{ govukTable({
			caption: "Case boundaries",
			captionClasses: "govuk-visually-hidden",
			firstCellIsHeader: true,
			head: [
				{ text: "Case reference" },
				{ text: "Case name" },
				{ text: "File" },
				{ text: "Received" },
				{ text: "Geometry" }
			],
			rows: tableRows
		}) }}
	{% endif %}

	{% if pagination %}
		{{ govukPagination(pagination) }}
	{% endif %}
{% endblock %}
