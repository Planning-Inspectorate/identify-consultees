{% extends "admin/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
    {{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block adminContent %}
    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

    {% if loaded %}
        <h2 class="govuk-heading-m">In the database</h2>
        {{ govukSummaryList({
            rows: [
                { key: { text: "Cases" }, value: { text: loaded.cases ~ " (" ~ loaded.casesFromCbos ~ " from CBOS)" } },
                { key: { text: "Case boundaries" }, value: { text: loaded.boundaries ~ " (" ~ loaded.boundariesFromCbos ~ " from CBOS)" } }
            ]
        }) }}
    {% endif %}

    {% if error %}
        {{ govukErrorMessage({ text: error }) }}
        {% set checkRows = [{ key: { text: "Import" }, value: { text: cause } }] %}
        {% if connection.error %}
            {% set checkRows = (checkRows.push({ key: { text: "CBOS connection check" }, value: { text: connection.error } }), checkRows) %}
        {% else %}
            {% for name, check in { "CBOS database": connection.database, "CBOS documents": connection.storage } %}
                {% set checkRows = (checkRows.push({
                    key: { text: name },
                    value: { text: (check.status == "OK" and "OK - " or "Failed - ") ~ check.detail }
                }), checkRows) %}
            {% endfor %}
        {% endif %}
        <h2 class="govuk-heading-m">What went wrong</h2>
        {{ govukSummaryList({ rows: checkRows }) }}
        <p class="govuk-body">
            "Login failed" on the database means this environment's function app has no user in
            CBOS's database - its owners need to add one. A timeout or "server was not found" means
            the function can't reach CBOS over the network. A failed documents check means it can't
            read CBOS's document storage.
        </p>
    {% endif %}

    {% if imported != undefined %}
        {{ govukNotificationBanner({
            type: "success",
            titleText: "Success",
            text: "Imported " ~ imported ~ " of " ~ filesFound ~ " CBOS boundary files, for " ~ casesImported ~ " cases."
        }) }}
    {% endif %}

    {% if failures and failures.length > 0 %}
        <h2 class="govuk-heading-m">Files not imported</h2>
        {% set failureRows = [] %}
        {% for failure in failures %}
            {% set failureRows = (failureRows.push([
                { text: failure.caseReference },
                { text: failure.fileName | default("") },
                { text: failure.reason }
            ]), failureRows) %}
        {% endfor %}
        {{ govukTable({
            head: [{ text: "Case reference" }, { text: "File" }, { text: "Reason" }],
            rows: failureRows
        }) }}
    {% endif %}

    <p class="govuk-body">
        Imports every case boundary in CBOS's "GIS Shapefiles" folders - every version CBOS converted
        to GeoJSON. Boundaries already here are updated, and nothing is deleted. A case's boundary page
        lists them all to pick from; elsewhere, as for Nearby NSIPs, a case is its newest boundary.
    </p>

    <p class="govuk-body">
        It can take several minutes. If the page times out, the import carries on: reload this page
        in a few minutes and check the counts, rather than importing again.
    </p>

    <form method="post" action="/admin/import-from-cbos/run" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ govukButton({ text: "Import cases from CBOS" }) }}
    </form>
{% endblock %}
