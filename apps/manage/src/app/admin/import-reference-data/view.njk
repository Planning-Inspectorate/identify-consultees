{% extends "admin/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
    {{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block adminContent %}
    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

    <p class="govuk-body">
        Internal tool - loads files already uploaded to blob storage
        (<a class="govuk-link" href="/admin/upload-to-blob">/admin/upload-to-blob</a>) into the
        database, using the app's own managed identity.
    </p>

    <p class="govuk-body">
        A load can take several minutes. If the page times out, the load carries on - wait a few
        minutes, then reload this page and check the counts rather than submitting again.
    </p>

    {% if error %}
        {{ govukErrorMessage({ text: error }) }}
    {% endif %}

    {% if groupLoaded %}
        {{ govukNotificationBanner({ type: "success", titleText: "Success", text: groupLoaded }) }}
    {% endif %}

    {% if consulteeAreasCleared != undefined %}
        {{ govukNotificationBanner({
            type: "success",
            titleText: "Success",
            text: "Cleared the consultee areas: deleted " ~ consulteeAreasCleared ~ "."
        }) }}
    {% endif %}

    {% if caseBoundariesImported != undefined %}
        {{ govukNotificationBanner({
            type: "success",
            titleText: "Success",
            text: "Replaced case boundaries: imported " ~ caseBoundariesImported ~ "."
        }) }}
    {% endif %}

    {% if loadedConsulteeAreas != undefined %}
        <h2 class="govuk-heading-m">Currently loaded</h2>
        {{ govukSummaryList({
            rows: [
                { key: { text: "Consultee areas" }, value: { text: loadedConsulteeAreas } },
                { key: { text: "Case boundaries" }, value: { text: loadedCaseBoundaries } }
            ]
        }) }}
    {% endif %}

    <h2 class="govuk-heading-m">Consultee areas, by group</h2>
    <p class="govuk-body">
        The reference data is loaded a group at a time - the report's tabs, as
        <code>config/reference-data.yaml</code> sets them. Loading a group takes its newest file in
        blob storage (<code>YYYYMMDD_&lt;group&gt;.geojson</code>, named for the date its data is
        from) and replaces that group's consultee areas. If the file is from a later quarter than
        the group's loaded data, the loaded data is moved to the archive first. A file holding a
        category from another group, or from an earlier quarter, isn't loaded.
    </p>

    {% if blobStorageRead === false %}
        {{ govukWarningText({ text: "Blob storage couldn't be read, so no group's file is shown.", iconFallbackText: "Warning" }) }}
    {% endif %}

    {% set groupRows = [] %}
    {% for group in groups %}
        {% set fileHtml %}
            {% if group.file %}
                {{ group.file.name }}<br>
                <span class="govuk-hint">Data from {{ group.file.dataDate }} ({{ group.file.quarter }}), {{ group.file.size }}</span>
            {% else %}
                No file uploaded
            {% endif %}
        {% endset %}
        {% set loadedHtml %}
            {% if group.rows != undefined %}{{ group.rows }} consultee areas{% endif %}
            {% if group.load %}
                <br><span class="govuk-hint">{{ group.load.quarter }}, from {{ group.load.blobName }}, loaded {{ group.load.loadedAt }}</span>
            {% elif group.rows %}
                <br><span class="govuk-hint">Quarter not known - loaded before loads were logged</span>
            {% endif %}
        {% endset %}
        {% set actionHtml %}
            {% if group.file %}
                <form method="post" action="/admin/import-reference-data/run-consultee-area-group" novalidate>
                    <input type="hidden" name="_csrf" value="{{ _csrf }}">
                    <input type="hidden" name="group" value="{{ group.slug }}">
                    {{ govukButton({ text: "Load", classes: "govuk-!-margin-bottom-0", attributes: { "aria-label": "Load " ~ group.name } }) }}
                </form>
            {% endif %}
        {% endset %}
        {% set groupRows = (groupRows.push([
            { html: "<strong>" ~ (group.name | escape) ~ "</strong><br><span class=\"govuk-hint\">" ~ (group.categories | escape) ~ "</span>" },
            { html: fileHtml },
            { html: loadedHtml },
            { html: actionHtml }
        ]), groupRows) %}
    {% endfor %}
    {{ govukTable({
        caption: "Consultee area groups",
        captionClasses: "govuk-visually-hidden",
        head: [
            { text: "Group" },
            { text: "In blob storage" },
            { text: "Loaded" },
            { html: "<span class=\"govuk-visually-hidden\">Action</span>" }
        ],
        rows: groupRows
    }) }}

    <h2 class="govuk-heading-m">Clear consultee areas</h2>
    {{ govukWarningText({
        text: "Deletes every consultee area, in every group. The table itself, the files in blob storage and the archive are left as they are - load each group again afterwards.",
        iconFallbackText: "Warning"
    }) }}
    <form method="post" action="/admin/import-reference-data/clear-consultee-areas" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ govukButton({ text: "Clear consultee areas", classes: "govuk-button--warning" }) }}
    </form>

    <h2 class="govuk-heading-m">Case boundaries</h2>
    <p class="govuk-body">Replaces all case boundaries with <code>all-project-boundaries.geojson</code> from blob storage.</p>
    <form method="post" action="/admin/import-reference-data/run-case-boundaries" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ govukButton({ text: "Replace case boundaries", classes: "govuk-button--warning" }) }}
    </form>
{% endblock %}
