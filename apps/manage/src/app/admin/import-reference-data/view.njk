{% extends "admin/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
    {{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block adminContent %}
    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

    <p class="govuk-body">
        Internal tool - loads files already uploaded to blob storage
        (<a class="govuk-link" href="/admin/upload-to-blob">/admin/upload-to-blob</a>) into the
        database, using the app's own managed identity.
    </p>

    <p class="govuk-body">
        A load can take several minutes. If the page times out, the load carries on - wait a few
        minutes, then reload this page and check the counts rather than submitting again.
    </p>

    {% if error %}
        {{ govukErrorMessage({ text: error }) }}
    {% endif %}

    {% if groupLoaded %}
        {{ govukNotificationBanner({ type: "success", titleText: "Success", text: groupLoaded }) }}
    {% endif %}

    {% if consulteeAreasCleared %}
        {{ govukNotificationBanner({
            type: "success",
            titleText: "Success",
            text: "Cleared the " ~ consulteeAreasCleared.quarter ~ " dataset: deleted " ~ consulteeAreasCleared.deleted ~ " consultee areas."
        }) }}
    {% endif %}

    {% if caseBoundariesImported != undefined %}
        {{ govukNotificationBanner({
            type: "success",
            titleText: "Success",
            text: "Imported case boundaries: " ~ caseBoundariesImported ~ "."
        }) }}
    {% endif %}

    {% if loadedConsulteeAreas != undefined %}
        <h2 class="govuk-heading-m">Currently loaded</h2>
        {{ govukSummaryList({
            rows: [
                { key: { text: "Consultee areas" }, value: { text: loadedConsulteeAreas } },
                { key: { text: "Case boundaries" }, value: { text: loadedCaseBoundaries } }
            ]
        }) }}
    {% endif %}

    <h2 class="govuk-heading-m">Datasets</h2>
    <p class="govuk-body">
        Each quarter's consultee areas are a dataset - a table of their own,
        <code>consultee_area_2026Q4</code> - and the tool uses the newest quarter that has every
        group loaded. Earlier quarters are kept as they are.
    </p>

    {% if datasets %}
        {% set datasetRows = [] %}
        {% for dataset in datasets %}
            {% set datasetRows = (datasetRows.push([
                { text: dataset.quarter },
                { text: dataset.rows, format: "numeric" },
                { text: dataset.status }
            ]), datasetRows) %}
        {% endfor %}
        {{ govukTable({
            caption: "Consultee area datasets",
            captionClasses: "govuk-visually-hidden",
            firstCellIsHeader: true,
            head: [{ text: "Quarter" }, { text: "Consultee areas", format: "numeric" }, { text: "Status" }],
            rows: datasetRows
        }) }}
    {% endif %}

    {% if pending %}
        {% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
        {{ govukInsetText({
            text: pending.quarter ~ " is being loaded. The tool keeps using " ~ datasetInUse ~ " until " ~ (pending.waitingFor | join(", ")) ~ (" are" if pending.waitingFor.length > 1 else " is") ~ " loaded for " ~ pending.quarter ~ "."
        }) }}
    {% endif %}

    <h2 class="govuk-heading-m">Consultee areas, by group</h2>
    <p class="govuk-body">
        The reference data is loaded a group at a time - the report's tabs, as
        <code>config/reference-data.yaml</code> sets them. Loading a group takes its newest file in
        blob storage (<code>YYYYMMDD_&lt;group&gt;.geojson</code>, named for the date its data is
        from) and replaces that group's consultee areas in the dataset for its quarter, made the
        first time one of the quarter's groups is loaded. A file holding a category from another
        group, or from an earlier quarter than the one in use, isn't loaded.
    </p>

    {% if blobStorageRead === false %}
        {{ govukWarningText({ text: "Blob storage couldn't be read, so no group's file is shown.", iconFallbackText: "Warning" }) }}
    {% endif %}

    {% set groupRows = [] %}
    {% for group in groups %}
        {% set fileHtml %}
            {% if group.file %}
                {{ group.file.name }}<br>
                <span class="govuk-hint">Data from {{ group.file.dataDate }} ({{ group.file.quarter }}), {{ group.file.size }}</span>
            {% else %}
                No file uploaded
            {% endif %}
        {% endset %}
        {% set loadedHtml %}
            {% if group.rows != undefined %}{{ group.rows }} consultee areas{% if datasetInUse %} in {{ datasetInUse }}{% endif %}{% endif %}
            {% if group.pendingRows != undefined %}<br><span class="govuk-hint">{{ group.pendingRows }} in {{ pending.quarter }}</span>{% endif %}
            {% if group.load %}
                <br><span class="govuk-hint">{{ group.load.quarter }}, from {{ group.load.blobName }}, loaded {{ group.load.loadedAt }}</span>
            {% elif group.rows %}
                <br><span class="govuk-hint">Quarter not known - loaded before loads were logged</span>
            {% endif %}
        {% endset %}
        {% set actionHtml %}
            {% if group.file %}
                <form method="post" action="/admin/import-reference-data/run-consultee-area-group" novalidate>
                    <input type="hidden" name="_csrf" value="{{ _csrf }}">
                    <input type="hidden" name="group" value="{{ group.slug }}">
                    {{ govukButton({ text: "Load", classes: "govuk-!-margin-bottom-0", attributes: { "aria-label": "Load " ~ group.name } }) }}
                </form>
            {% endif %}
        {% endset %}
        {% set groupRows = (groupRows.push([
            { html: "<strong>" ~ (group.name | escape) ~ "</strong><br><span class=\"govuk-hint\">" ~ (group.categories | escape) ~ "</span>" },
            { html: fileHtml },
            { html: loadedHtml },
            { html: actionHtml }
        ]), groupRows) %}
    {% endfor %}
    {{ govukTable({
        caption: "Consultee area groups",
        captionClasses: "govuk-visually-hidden",
        head: [
            { text: "Group" },
            { text: "In blob storage" },
            { text: "Loaded" },
            { html: "<span class=\"govuk-visually-hidden\">Action</span>" }
        ],
        rows: groupRows
    }) }}

    <h2 class="govuk-heading-m">Clear consultee areas</h2>
    {% if datasets and datasets.length > 0 %}
        {{ govukWarningText({
            text: "Deletes every consultee area in the dataset you choose, in every group. Its table, other quarters' datasets and the files in blob storage are left as they are - load each group again afterwards.",
            iconFallbackText: "Warning"
        }) }}
        {% set datasetItems = [] %}
        {% for dataset in datasets %}
            {% set datasetItems = (datasetItems.push({
                value: dataset.quarter,
                text: dataset.quarter ~ " - " ~ (dataset.status | lower) ~ ", " ~ dataset.rows ~ " consultee areas",
                selected: dataset.quarter == datasetInUse
            }), datasetItems) %}
        {% endfor %}
        <form method="post" action="/admin/import-reference-data/clear-consultee-areas" novalidate>
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            {{ govukSelect({
                id: "quarter",
                name: "quarter",
                label: { text: "Dataset to clear" },
                items: datasetItems
            }) }}
            {{ govukButton({ text: "Clear consultee areas", classes: "govuk-button--warning" }) }}
        </form>
    {% else %}
        <p class="govuk-body">There's no dataset to clear.</p>
    {% endif %}

    <h2 class="govuk-heading-m">Case boundaries</h2>
    <p class="govuk-body">Imports the case boundaries in <code>all-project-boundaries.geojson</code> from blob storage. Boundaries already here are updated, and nothing is deleted - including those imported from CBOS.</p>
    <form method="post" action="/admin/import-reference-data/run-case-boundaries" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ govukButton({ text: "Import case boundaries" }) }}
    </form>
{% endblock %}
