{% extends "admin/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block pageTitle %}
    {{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block adminContent %}
    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

    <p class="govuk-body">
        Internal tool - uploads a file directly to the application's own blob storage container
        (<code>infrastructure/storage.tf</code>), using the app's managed identity. Useful for
        getting a large file (e.g. the full real reference dataset - see
        <code>packages/database/src/seed/import-from-blob.ts</code>) into storage without needing
        VPN/Bastion access to the storage account's private endpoint.
    </p>

    {% if uploadedBlobName %}
        {{ govukNotificationBanner({
            type: "success",
            titleText: "Success",
            text: "Uploaded \"" + uploadedBlobName + "\" to blob storage."
        }) }}
    {% endif %}

    {# blob-upload.js sends the file a part at a time (data-chunk-bytes each) rather than in one
       request, which a large file can't finish within Front Door's timeout; without it the form
       posts the whole file #}
    <form method="post" action="/admin/upload-to-blob/run" enctype="multipart/form-data" novalidate
        data-chunked-upload data-chunk-bytes="{{ chunkBytes }}" data-max-upload-bytes="{{ maxUploadBytes }}"
        data-csrf-token="{{ _csrf }}">
        {% if error %}
            {{ govukErrorMessage({ text: error }) }}
        {% endif %}

        {{ govukFileUpload({
            id: "file",
            name: "file",
            label: { text: "Upload a file" },
            hint: { text: "Up to 1GB. The file is saved under its own name - to import consultee areas, name it combined_reference_data_v1.geojson." }
        }) }}

        <p class="govuk-body" role="status" aria-live="polite" data-upload-status></p>

        {{ govukButton({ text: "Upload" }) }}
    </form>
{% endblock %}

{% block bodyEnd %}
    <script type="module" src="/{{ config.blobUploadJs }}"></script>
{% endblock %}
