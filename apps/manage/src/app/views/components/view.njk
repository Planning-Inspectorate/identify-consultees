{% extends "views/layouts/main.njk" %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
	<p class="govuk-body">
		Every component shipped with the installed version of GOV.UK Frontend,
		rendered from the fixture data it publishes for testing. Select a
		component to see all of its documented examples.
	</p>

	<ul class="govuk-list govuk-list--bullet">
		{% for component in components %}
			<li>
				<a class="govuk-link" href="{{ component.href }}">{{ component.title }}</a>
				({{ component.exampleCount }} example{{ 's' if component.exampleCount != 1 }})
			</li>
		{% endfor %}
	</ul>

	<h2 class="govuk-heading-m govuk-!-margin-top-8">Third-party components</h2>
	<ul class="govuk-list govuk-list--bullet">
		<li>
			<a class="govuk-link" href="{{ interactiveMapHref }}">Defra Interactive Map</a>
			— accessible map examples with cached static fallbacks
		</li>
	</ul>
{% endblock %}
