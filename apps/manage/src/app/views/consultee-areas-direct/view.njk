{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
    {{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
    <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

    <p class="govuk-body">
        Queries the <code>consultee_area</code> table directly via Prisma
        (<code>packages/database/src/geospatial/consultee-areas.ts</code>) - no Azure Function
        involved. Compare with <a class="govuk-link" href="/consultee-areas-python">the Python
        function version</a>, which queries the same table.
    </p>

    <form method="post" action="/consultee-areas-direct/run" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ govukButton({ text: "Run query" }) }}
    </form>

    {% if error %}
        {{ govukErrorMessage({ text: error }) }}
    {% endif %}

    {% if rows %}
        {% if rows.length == 0 %}
            <p class="govuk-body">No consultee areas found.</p>
        {% else %}
            {% set tableRows = [] %}
            {% for row in rows %}
                {% set tableRows = (tableRows.push([
                    { text: row.properties.consultee | default("") },
                    { text: row.properties.consulteeCategory | default("") },
                    { text: row.properties.region | default("") },
                    { text: row.geometry.type }
                ]), tableRows) %}
            {% endfor %}

            {{ govukTable({
                head: [
                    { text: "Consultee" },
                    { text: "Category" },
                    { text: "Region" },
                    { text: "Geometry type" }
                ],
                rows: tableRows
            }) }}
        {% endif %}
    {% endif %}
{% endblock %}
