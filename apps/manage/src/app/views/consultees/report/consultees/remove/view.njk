{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% block pageTitle %}
	{% if errorSummary %}Error: {% endif %}{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{# a one-question form: the heading and everything below it sit in a two-thirds column #}
{% block pageHeading %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds">
			<h1 class="govuk-heading-l">
				{% if pageCaption %}
					<span class="govuk-caption-l">{{ pageCaption }}</span>
				{% endif %}
				{{ pageHeading }}
			</h1>
		</div>
	</div>
{% endblock %}

{% block pageContent %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds">
			{% set summaryRows = [] %}
			{% for consultee in consultees %}
				{# one reason per line - each item is autoescaped #}
				{% set identifiedHtml %}{% for reason in consultee.identified %}{{ reason }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% endset %}
				{% set summaryRows = (summaryRows.push([
					{ text: consultee.name, classes: "govuk-table__cell--no-wrap" },
					{ html: identifiedHtml }
				]), summaryRows) %}
			{% endfor %}
			{{ govukTable({
				caption: "Consultees being removed" if consultees.length > 1 else "Consultee being removed",
				captionClasses: "govuk-visually-hidden",
				firstCellIsHeader: true,
				head: [
					{ text: "Name" },
					{ text: "Identified" }
				],
				rows: summaryRows
			}) }}

			<form method="post" action="{{ formAction }}" novalidate>
				<input type="hidden" name="_csrf" value="{{ _csrf }}">
				{{ govukTextarea({
					label: {
						text: "Reason for removing",
						classes: "govuk-label--m"
					},
					id: "removal-reason",
					name: "reason",
					value: reasonValue,
					errorMessage: reasonError,
					rows: 5
				}) }}

				{{ govukButton({
					text: "Remove consultee"
				}) }}
			</form>
		</div>
	</div>
{% endblock %}
