{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% block pageTitle %}
	{% if errorSummary %}Error: {% endif %}{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block head %}
	{{ super() }}
	<link rel="stylesheet" href="/{{ config.accessibleAutocompleteCss }}">
	<link rel="stylesheet" href="/{{ config.vendorInteractiveMapCss }}">
	<link rel="stylesheet" href="/{{ config.vendorDatasetsPluginCss }}">
{% endblock %}

{% block pageContent %}
	{% if rulesetFailed %}
		{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
		{% set failureHtml %}
			<h3 class="govuk-notification-banner__heading">The ruleset could not be run</h3>
			<p class="govuk-body">No consultees are shown because the search did not finish. This is not the same as finding no consultees. <a class="govuk-notification-banner__link" href="{{ retryUrl }}">Try again</a>.</p>
		{% endset %}
		{{ govukNotificationBanner({ html: failureHtml }) }}
	{% endif %}

	{% if mapIsSampled %}
		{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
		{{ govukInsetText({
			text: "This ruleset matched " ~ matchCount ~ " consultees - showing a sample of " ~ mapSampleSize ~ " on the map below."
		}) }}
	{% endif %}

	{% set mapRegionLabel = mapRegionLabel %}
	{% set staticMapSrc = staticMapSrc %}
	{% set staticMapAlt = staticMapAlt %}
	{% set mapWidth = mapWidth %}
	{% set mapHeight = mapHeight %}
	{% set mapConfigJson = mapConfigJson %}
	{% include "views/partials/consultee-map-region.njk" %}

	{% if not rulesetFailed %}
		<h2 class="govuk-heading-m govuk-!-margin-top-6" id="consultees">Consultees</h2>

		{% if rows.length == 0 %}
			<p class="govuk-body">No consultees identified in this category.</p>
		{% else %}
			{% set tableRows = [] %}
			{% for row in rows %}
				{% set removeLink %}
					<a class="govuk-link" href="{{ row.removeUrl }}">Remove<span class="govuk-visually-hidden"> {{ row.name }}</span></a>
				{% endset %}
				{# one reason per line - each item is autoescaped #}
				{% set identifiedHtml %}{% for reason in row.identified %}{{ reason }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% endset %}
				{% set tableRows = (tableRows.push([
					{ text: row.name, classes: "govuk-table__cell--no-wrap" },
					{ html: identifiedHtml },
					{ html: removeLink }
				]), tableRows) %}
			{% endfor %}
			{{ govukTable({
				caption: "Consultees",
				captionClasses: "govuk-visually-hidden",
				firstCellIsHeader: true,
				head: [
					{ text: "Name" },
					{ text: "Identified" },
					{ text: "Actions" }
				],
				rows: tableRows
			}) }}
		{% endif %}
	{% endif %}

	<h2 class="govuk-heading-m govuk-!-margin-top-6" id="add-consultee">Add a consultee</h2>
	<form method="post" action="{{ addFormAction }}" novalidate>
		<input type="hidden" name="_csrf" value="{{ _csrf }}">
		{% if nearbySuggestions | length %}
			{# typed names are matched to the consultees near the site the ruleset didn't identify - the
			faint ones on the map. The datalist suggests them as the name is typed;
			consultee-autocomplete.js swaps it for the GOV.UK accessible autocomplete #}
			{{ govukInput({
				label: { text: "Name of consultee", classes: "govuk-label--s" },
				hint: { text: "Start typing to choose a consultee near the site that the ruleset did not identify. They are shown faintly on the map. You can also enter a consultee that is not suggested." },
				id: "consultee-name",
				name: "name",
				value: addForm.nameValue,
				errorMessage: addForm.nameError,
				autocomplete: "off",
				spellcheck: false,
				attributes: { list: "nearby-consultees", "data-consultee-autocomplete": "" }
			}) }}
			<datalist id="nearby-consultees">
				{% for suggestion in nearbySuggestions %}
					<option value="{{ suggestion.name }}" label="{{ suggestion.hint }}"></option>
				{% endfor %}
			</datalist>
		{% else %}
			{{ govukInput({
				label: { text: "Name of consultee", classes: "govuk-label--s" },
				id: "consultee-name",
				name: "name",
				value: addForm.nameValue,
				errorMessage: addForm.nameError,
				spellcheck: false
			}) }}
		{% endif %}

		{{ govukTextarea({
			label: { text: "Reason for adding", classes: "govuk-label--s" },
			id: "consultee-reason",
			name: "reason",
			value: addForm.reasonValue,
			errorMessage: addForm.reasonError,
			rows: 3
		}) }}

		{{ govukButton({
			text: "Add consultee",
			classes: "govuk-button--secondary"
		}) }}
	</form>

	{% if removedRows.length > 0 %}
		{% set removedTableRows = [] %}
		{% for row in removedRows %}
			{% set removedTableRows = (removedTableRows.push([
				{ text: row.name, classes: "govuk-table__cell--no-wrap" },
				{ text: row.reason }
			]), removedTableRows) %}
		{% endfor %}
		{% set removedHtml %}
			<h3 class="govuk-heading-s">Removed consultees</h3>
			{{ govukTable({
				caption: "Removed consultees",
				captionClasses: "govuk-visually-hidden",
				firstCellIsHeader: true,
				head: [
					{ text: "Name" },
					{ text: "Reason" }
				],
				rows: removedTableRows
			}) }}
		{% endset %}
		{{ govukDetails({
			summaryText: "Removed consultees",
			html: removedHtml,
			open: removedOpen
		}) }}
	{% endif %}

	<div>
		{{ govukButton({
			text: "Save and return",
			href: saveAndReturnUrl
		}) }}
	</div>
{% endblock %}

{% block bodyEnd %}
	<script defer src="/{{ config.vendorInteractiveMapJs }}"></script>
	<script defer src="/{{ config.vendorMaplibreProviderJs }}"></script>
	<script defer src="/{{ config.vendorDatasetsPluginJs }}"></script>
	<script defer src="/{{ config.vendorInteractPluginJs }}"></script>
	<script type="module" src="/{{ config.consulteesMapJs }}"></script>
	<script defer src="/{{ config.accessibleAutocompleteJs }}"></script>
	<script type="module" src="/{{ config.consulteeAutocompleteJs }}"></script>
{% endblock %}
