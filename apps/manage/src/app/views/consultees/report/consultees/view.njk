{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block head %}
	{{ super() }}
	<link rel="stylesheet" href="/{{ config.vendorInteractiveMapCss }}">
	<link rel="stylesheet" href="/{{ config.vendorDatasetsPluginCss }}">
{% endblock %}

{% block pageContent %}
	{% if rulesetFailed %}
		{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
		{% set failureHtml %}
			<h3 class="govuk-notification-banner__heading">The ruleset could not be run</h3>
			<p class="govuk-body">No consultees are shown because the search did not finish. This is not the same as finding no consultees. <a class="govuk-notification-banner__link" href="{{ retryUrl }}">Try again</a>.</p>
		{% endset %}
		{{ govukNotificationBanner({ html: failureHtml }) }}
	{% endif %}

	{% if screenedBoundingBox and not rulesetFailed %}
		{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
		{{ govukWarningText({
			text: "This site's outline is too detailed to screen in time, so its consultees were found using the rectangle around it (its bounding box). The list can include consultees that are not near the site - check each one before creating the report.",
			iconFallbackText: "Warning"
		}) }}
	{% endif %}

	{% set mapRegionLabel = mapRegionLabel %}
	{% set staticMapSrc = staticMapSrc %}
	{% set staticMapAlt = staticMapAlt %}
	{% set mapWidth = mapWidth %}
	{% set mapHeight = mapHeight %}
	{% set mapConfigJson = mapConfigJson %}
	{% include "views/partials/consultee-map-region.njk" %}

	{% if not rulesetFailed %}
		<h2 class="govuk-heading-m govuk-!-margin-top-6" id="consultees">Included consultees</h2>

		{% if rows.length == 0 %}
			<p class="govuk-body">No consultees identified in this category.</p>
		{% else %}
			<form method="get" action="{{ bulkRemove.formAction }}">
				{% for param in bulkRemove.hiddenParams %}
					<input type="hidden" name="{{ param.name }}" value="{{ param.value }}">
				{% endfor %}
				{% set tableRows = [] %}
				{# MoJ multi-select pattern: a checkbox-only first column, its header holding the
				   Select all box. It submits `select-all` when JS never ran - the remove page
				   reads that as every listed consultee; consultee-select.js strips the name and
				   wires the toggling instead #}
				{% set selectAllHtml %}
					<div class="govuk-checkboxes__item govuk-checkboxes--small moj-multi-select__checkbox">
						<input class="govuk-checkboxes__input" id="consultees-checkboxes-all" name="select-all" type="checkbox" value="true">
						<label class="govuk-label govuk-checkboxes__label moj-multi-select__toggle-label" for="consultees-checkboxes-all"><span class="govuk-visually-hidden">Select all</span></label>
					</div>
				{% endset %}
				{% for row in rows %}
					{% set removeLink %}
						<a class="govuk-link" href="{{ row.removeUrl }}">Remove<span class="govuk-visually-hidden"> {{ row.name }}</span></a>
					{% endset %}
					{% set selectHtml %}
						<div class="govuk-checkboxes__item govuk-checkboxes--small moj-multi-select__checkbox">
							<input class="govuk-checkboxes__input" id="{{ row.select.domId }}" name="{{ row.select.param }}" type="checkbox" value="{{ row.select.value }}">
							<label class="govuk-label govuk-checkboxes__label" for="{{ row.select.domId }}"><span class="govuk-visually-hidden">Select {{ row.name }}</span></label>
						</div>
					{% endset %}
					{# one reason per line - each item is autoescaped #}
					{% set identifiedHtml %}{% for reason in row.identified %}{{ reason }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% endset %}
					{% set tableRows = (tableRows.push([
						{ html: selectHtml },
						{ text: row.name, classes: "govuk-table__cell--no-wrap" },
						{ html: identifiedHtml },
						{ html: removeLink }
					]), tableRows) %}
				{% endfor %}
				{{ govukTable({
					caption: "Included consultees",
					captionClasses: "govuk-visually-hidden",
					attributes: { "data-module": "consultee-select", "data-id-prefix": "consultees-" },
					head: [
						{ html: selectAllHtml, attributes: { id: "consultees-select-all" } },
						{ text: "Name" },
						{ text: "Identified" },
						{ text: "Actions" }
					],
					rows: tableRows
				}) }}
				{{ govukButton({
					text: "Remove selected",
					classes: "govuk-button--warning"
				}) }}
			</form>
		{% endif %}
	{% endif %}

	<div class="govuk-!-margin-top-6">
		{{ govukButton({
			text: "Add a consultee",
			href: addConsulteeUrl,
			classes: "govuk-button--secondary"
		}) }}
	</div>

	{% if removedRows.length > 0 %}
		{% set removedTableRows = [] %}
		{% for row in removedRows %}
			{% set removedTableRows = (removedTableRows.push([
				{ text: row.name, classes: "govuk-table__cell--no-wrap" },
				{ text: row.reason }
			]), removedTableRows) %}
		{% endfor %}
		{% set removedHtml %}
			<h3 class="govuk-heading-s">Removed consultees</h3>
			{{ govukTable({
				caption: "Removed consultees",
				captionClasses: "govuk-visually-hidden",
				firstCellIsHeader: true,
				head: [
					{ text: "Name" },
					{ text: "Reason" }
				],
				rows: removedTableRows
			}) }}
		{% endset %}
		{{ govukDetails({
			summaryText: "Removed consultees",
			html: removedHtml,
			open: removedOpen
		}) }}
	{% endif %}
{% endblock %}

{% block bodyEnd %}
	<script defer src="/{{ config.vendorInteractiveMapJs }}"></script>
	<script defer src="/{{ config.vendorMaplibreProviderJs }}"></script>
	<script defer src="/{{ config.vendorDatasetsPluginJs }}"></script>
	<script defer src="/{{ config.vendorInteractPluginJs }}"></script>
	<script type="module" src="/{{ config.consulteesMapJs }}"></script>
	<script type="module" src="/{{ config.consulteeSelectJs }}"></script>
{% endblock %}
