{% extends "views/layouts/main.njk" %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block pageTitle %}
	{% if errorSummary %}Error: {% endif %}{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{# the success panel's own title is the page heading, so the layout's h1 only shows in
   the failure state - which has no panel, just the error summary #}
{% block pageHeading %}
	{% if downloadFailed %}{{ super() }}{% endif %}
{% endblock %}

{% block pageContent %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds">
			{% if downloadFailed %}
				<p class="govuk-body">
					Project: {{ caseName }}<br>Reference: {{ reference }}
				</p>
			{% else %}
				{% call govukPanel({
					titleText: pageHeading
				}) %}
					Project: {{ caseName }}<br>Reference: {{ reference }}
				{% endcall %}

				<p class="govuk-body govuk-!-margin-top-6">
					<a class="govuk-link" href="{{ downloadUrl }}">{{ downloadText }}</a>
				</p>
			{% endif %}

			{% if rulesetFailed %}
				{% set failureHtml %}
					<h3 class="govuk-notification-banner__heading">The ruleset could not be run</h3>
					<p class="govuk-body">The report could not be created because the search did not finish. <a class="govuk-notification-banner__link" href="{{ retryUrl }}">Try again</a>.</p>
				{% endset %}
				{{ govukNotificationBanner({ html: failureHtml }) }}
			{% endif %}
		</div>
	</div>
{% endblock %}
