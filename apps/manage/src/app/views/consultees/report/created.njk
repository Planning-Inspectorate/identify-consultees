{% extends "views/layouts/main.njk" %}

{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{# the panel's own title is the page heading, so suppress the layout's h1 #}
{% block pageHeading %}{% endblock %}

{% block pageContent %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds">
			{% call govukPanel({
				titleText: pageHeading,
				classes: "govuk-panel--error" if downloadFailed
			}) %}
				Project: {{ caseName }}<br>Reference: {{ reference }}
				{% if downloadFailed %}
					{{ govukErrorMessage({ text: "The scoping report could not be downloaded - try again" }) }}
				{% endif %}
			{% endcall %}

			{% if not downloadFailed %}
				<p class="govuk-body govuk-!-margin-top-6">
					<a class="govuk-link" href="{{ downloadUrl }}">{{ downloadText }}</a>
				</p>
			{% endif %}

			{% if rulesetFailed %}
				{% set failureHtml %}
					<h3 class="govuk-notification-banner__heading">The ruleset could not be run</h3>
					<p class="govuk-body">The report could not be created because the search did not finish. <a class="govuk-notification-banner__link" href="{{ retryUrl }}">Try again</a>.</p>
				{% endset %}
				{{ govukNotificationBanner({ html: failureHtml }) }}
			{% endif %}
		</div>
	</div>
{% endblock %}
