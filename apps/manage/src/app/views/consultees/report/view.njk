{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
	{% if rulesetFailed %}
		{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
		{% set failureHtml %}
			<h3 class="govuk-notification-banner__heading">The ruleset could not be run</h3>
			<p class="govuk-body">No consultees are shown because the search did not finish. This is not the same as finding no consultees. <a class="govuk-notification-banner__link" href="{{ retryUrl }}">Try again</a>.</p>
		{% endset %}
		{{ govukNotificationBanner({ html: failureHtml }) }}
	{% endif %}

	<h2 class="govuk-heading-m">Report details</h2>
	{{ govukSummaryList({
		rows: [
			{
				key: { text: "Project" },
				value: { text: caseName },
				actions: {
					items: [
						{ href: caseChangeUrl, text: "Change", visuallyHiddenText: "project" }
					]
				}
			},
			{
				key: { text: "Project reference" },
				value: { text: reference }
			},
			{
				key: { text: "Shapefile" },
				value: { text: shapefileName },
				actions: {
					items: [
						{ href: shapefileChangeUrl, text: "Change", visuallyHiddenText: "shapefile" }
					]
				}
			},
			{
				key: { text: "Ruleset" },
				value: { text: rulesetName },
				actions: {
					items: [
						{ href: rulesetChangeUrl, text: "Change", visuallyHiddenText: "ruleset" }
					]
				}
			}
		]
	}) }}

	{% if not rulesetFailed %}
		<h2 class="govuk-heading-m">Identified consultees</h2>
		{% set consulteeRows = [] %}
		{% for consultee in consultees %}
			{% set valueHtml %}
				{% if consultee.total == 0 %}
					0
				{% else %}
					{% if consultee.total > consultee.names.length %}
						<p class="govuk-body">Showing {{ consultee.names.length }} of {{ consultee.total }} consultees</p>
					{% endif %}
					<ul class="govuk-list govuk-list--bullet">
						{% for name in consultee.names %}
							<li>{{ name }}</li>
						{% endfor %}
					</ul>
				{% endif %}
			{% endset %}
			{% set consulteeRows = (consulteeRows.push({
				key: { text: consultee.name },
				value: { html: valueHtml },
				actions: {
					items: [
						{ href: consultee.changeUrl, text: "Change", visuallyHiddenText: consultee.name }
					]
				}
			}), consulteeRows) %}
		{% endfor %}
		{{ govukSummaryList({ rows: consulteeRows }) }}
	{% endif %}

	{{ govukButton({
		text: "Create report",
		href: generateReportUrl
	}) }}
{% endblock %}
