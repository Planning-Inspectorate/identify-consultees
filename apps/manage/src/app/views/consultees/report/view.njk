{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
	{% if rulesetFailed %}
		{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
		{% set failureHtml %}
			<h3 class="govuk-notification-banner__heading">The ruleset could not be run</h3>
			<p class="govuk-body">No consultees are shown because the search did not finish. This is not the same as finding no consultees. <a class="govuk-notification-banner__link" href="{{ retryUrl }}">Try again</a>.</p>
		{% endset %}
		{{ govukNotificationBanner({ html: failureHtml }) }}
	{% endif %}

	{% if screenedBoundingBox and not rulesetFailed %}
		{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
		{{ govukWarningText({
			text: "This site's outline is too detailed to screen in time, so its consultees were found using the rectangle around it (its bounding box). The list can include consultees that are not near the site - check each one before creating the report.",
			iconFallbackText: "Warning"
		}) }}
	{% endif %}

	<h2 class="govuk-heading-m">Report details</h2>
	{{ govukSummaryList({
		rows: [
			{
				key: { text: "Project" },
				value: { text: caseName },
				classes: "govuk-summary-list__row--no-border",
				actions: {
					items: [
						{ href: caseChangeUrl, text: "Change", visuallyHiddenText: "project" }
					]
				}
			},
			{
				key: { text: "Project reference" },
				value: { text: reference }
			},
			{
				key: { text: "Shapefile" },
				value: { text: shapefileName },
				actions: {
					items: [
						{ href: shapefileChangeUrl, text: "Change", visuallyHiddenText: "shapefile" }
					]
				}
			},
			{
				key: { text: "Ruleset" },
				value: { text: rulesetName },
				actions: {
					items: [
						{ href: rulesetChangeUrl, text: "Change", visuallyHiddenText: "ruleset" }
					]
				}
			}
		]
	}) }}

	{% if not rulesetFailed %}
		<h2 class="govuk-heading-m">Identified consultees</h2>
		{# the exported workbook's tab groupings (see the controller's tabForCategory) #}
		{% for group in groups %}
			<h3 class="govuk-heading-s">{{ group.name }}</h3>
			{% set consulteeRows = [] %}
			{% for consultee in group.consultees %}
				{% set valueHtml %}
					{% if consultee.names.length == 0 %}
						No consultees
					{% elif consultee.names.length == 1 %}
						{{ consultee.names | first }}
					{% else %}
						{# more than five names and the rest sit behind "Show more" #}
						<ul class="govuk-list govuk-list--bullet">
							{% for name in consultee.names %}
								{% if loop.index <= 5 %}
									<li>{{ name }}</li>
								{% endif %}
							{% endfor %}
						</ul>
						{% if consultee.names.length > 5 %}
							{% set moreHtml %}
								<ul class="govuk-list govuk-list--bullet">
									{% for name in consultee.names %}
										{% if loop.index > 5 %}
											<li>{{ name }}</li>
										{% endif %}
									{% endfor %}
								</ul>
							{% endset %}
							{# "Show less" is the same summary element moved below the list by CSS
							when open - keeps the native details toggle (no JS needed) #}
							{% set summaryHtml %}
								<span class="pins-show-more__more">Show more</span><span class="pins-show-more__less">Show less</span>
							{% endset %}
							{{ govukDetails({ summaryHtml: summaryHtml, html: moreHtml, classes: "pins-show-more" }) }}
						{% endif %}
					{% endif %}
				{% endset %}
				{% set consulteeRows = (consulteeRows.push({
					key: { text: consultee.name },
					value: { html: valueHtml },
					actions: {
						items: [
							{ href: consultee.changeUrl, text: "Change", visuallyHiddenText: consultee.name }
						]
					}
				}), consulteeRows) %}
			{% endfor %}
			{{ govukSummaryList({ rows: consulteeRows }) }}
		{% endfor %}
	{% endif %}

	{{ govukButton({
		text: "Create report",
		href: generateReportUrl
	}) }}
{% endblock %}
