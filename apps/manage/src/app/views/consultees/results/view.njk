{% extends "views/layouts/main.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block head %}
	{{ super() }}
	<link rel="stylesheet" href="/{{ config.vendorInteractiveMapCss }}">
	<link rel="stylesheet" href="/{{ config.vendorDatasetsPluginCss }}">
	<link rel="stylesheet" href="/{{ config.vendorMapKeyPluginCss }}">
{% endblock %}

{% block pageContent %}
	{% if rulesetFailed %}
		{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
		{% set failureHtml %}
			<h3 class="govuk-notification-banner__heading">The ruleset could not be run</h3>
			<p class="govuk-body">No consultees are shown because the search did not finish. This is not the same as finding no consultees. <a class="govuk-notification-banner__link" href="{{ retryUrl }}">Try again</a>.</p>
		{% endset %}
		{{ govukNotificationBanner({ html: failureHtml }) }}
	{% endif %}

	<p class="govuk-body">
		Ruleset used: {{ rulesetName }}
	</p>

	{% if mapIsSampled %}
		{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
		{{ govukInsetText({
			text: "This ruleset matched " ~ matchCount ~ " consultees - showing a sample of " ~ mapSampleSize ~ " on the map below. The table further down lists all " ~ matchCount ~ "."
		}) }}
	{% endif %}

	{% set mapRegionLabel = mapRegionLabel %}
	{% set staticMapSrc = staticMapSrc %}
	{% set staticMapAlt = staticMapAlt %}
	{% set mapWidth = mapWidth %}
	{% set mapHeight = mapHeight %}
	{% set mapConfigJson = mapConfigJson %}
	{% include "views/partials/consultee-map-region.njk" %}

	{% if not rulesetFailed %}
	<h2 class="govuk-heading-m govuk-!-margin-top-6">Consultees identified ({{ matchCount }})</h2>

	{% if matches.length == 0 %}
		<p class="govuk-body">No consultees matched this ruleset.</p>
	{% else %}
		{% set tableRows = [] %}
		{% for match in matches %}
			{% set tableRows = (tableRows.push([
				{ text: match.consultee | default("") },
				{ text: match.consulteeCategory | default("") },
				{ text: match.region | default("") }
			]), tableRows) %}
		{% endfor %}
		{{ govukTable({
			caption: "Consultees identified",
			captionClasses: "govuk-visually-hidden",
			firstCellIsHeader: false,
			head: [
				{ text: "Consultee" },
				{ text: "Category" },
				{ text: "Region" }
			],
			rows: tableRows
		}) }}
	{% endif %}

	<h2 class="govuk-heading-m govuk-!-margin-top-6">All consultees within {{ nearbyRadiusKm }}km ({{ nearbyMatchCount }})</h2>
	<p class="govuk-body">Every consultee near the site, in any category, including those the ruleset didn't identify. The map shows only the consultees identified.</p>

	{% if nearbyMatches.length == 0 %}
		<p class="govuk-body">No consultees found within {{ nearbyRadiusKm }}km.</p>
	{% else %}
		{% set nearbyTableRows = [] %}
		{% for match in nearbyMatches %}
			{% set nearbyTableRows = (nearbyTableRows.push([
				{ text: match.consultee | default("") },
				{ text: match.consulteeCategory | default("") },
				{ text: match.region | default("") }
			]), nearbyTableRows) %}
		{% endfor %}
		{{ govukTable({
			caption: "All consultees within " ~ nearbyRadiusKm ~ "km",
			captionClasses: "govuk-visually-hidden",
			firstCellIsHeader: false,
			head: [
				{ text: "Consultee" },
				{ text: "Category" },
				{ text: "Region" }
			],
			rows: nearbyTableRows
		}) }}
	{% endif %}
	{% endif %}
{% endblock %}

{% block bodyEnd %}
	<script defer src="/{{ config.vendorInteractiveMapJs }}"></script>
	<script defer src="/{{ config.vendorMaplibreProviderJs }}"></script>
	<script defer src="/{{ config.vendorDatasetsPluginJs }}"></script>
	<script defer src="/{{ config.vendorMapKeyPluginJs }}"></script>
	<script defer src="/{{ config.vendorInteractPluginJs }}"></script>
	<script type="module" src="/{{ config.consulteesMapJs }}"></script>
{% endblock %}
