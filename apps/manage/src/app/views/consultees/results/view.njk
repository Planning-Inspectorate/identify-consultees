{% extends "views/layouts/main.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block head %}
	{{ super() }}
	<link rel="stylesheet" href="/{{ config.vendorInteractiveMapCss }}">
	<link rel="stylesheet" href="/{{ config.vendorDatasetsPluginCss }}">
	<link rel="stylesheet" href="/{{ config.vendorMapKeyPluginCss }}">
{% endblock %}

{% block beforeContent %}
	{{ govukBackLink({
		text: "Back to ruleset selection",
		href: backLinkUrl
	}) }}
{% endblock %}

{% block pageContent %}
	<p class="govuk-body">
		Ruleset used: {{ rulesetName }}
	</p>

	{% if mapIsSampled %}
		{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
		{{ govukInsetText({
			text: "This ruleset matched " ~ matchCount ~ " consultees - showing a sample of " ~ mapSampleSize ~ " on the map below. The table further down lists all " ~ matchCount ~ "."
		}) }}
	{% endif %}

	{% set mapRegionLabel = mapRegionLabel %}
	{% set staticMapSrc = staticMapSrc %}
	{% set staticMapAlt = staticMapAlt %}
	{% set mapWidth = mapWidth %}
	{% set mapHeight = mapHeight %}
	{% set mapConfigJson = mapConfigJson %}
	{% include "views/partials/consultee-map-region.njk" %}

	<h2 class="govuk-heading-m govuk-!-margin-top-6">Consultees identified ({{ matchCount }})</h2>

	{% if matches.length == 0 %}
		<p class="govuk-body">No consultees matched this ruleset.</p>
	{% else %}
		{% set tableRows = [] %}
		{% for match in matches %}
			{% set tableRows = (tableRows.push([
				{ text: match.consultee | default("") },
				{ text: match.consulteeCategory | default("") },
				{ text: match.region | default("") },
				{ text: match.distanceMetres ~ "m" }
			]), tableRows) %}
		{% endfor %}
		{{ govukTable({
			caption: "Consultees identified",
			captionClasses: "govuk-visually-hidden",
			firstCellIsHeader: false,
			head: [
				{ text: "Consultee" },
				{ text: "Category" },
				{ text: "Region" },
				{ text: "Distance" }
			],
			rows: tableRows
		}) }}
	{% endif %}
{% endblock %}

{% block bodyEnd %}
	<script defer src="/{{ config.vendorInteractiveMapJs }}"></script>
	<script defer src="/{{ config.vendorMaplibreProviderJs }}"></script>
	<script defer src="/{{ config.vendorDatasetsPluginJs }}"></script>
	<script defer src="/{{ config.vendorMapKeyPluginJs }}"></script>
	<script type="module" src="/{{ config.consulteesMapJs }}"></script>
{% endblock %}
