{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% block pageTitle %}
	{% if errorSummary %}Error: {% endif %}{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{# the radios' fieldset legend is the page heading, so suppress the layout's own h1 #}
{% block pageHeading %}{% endblock %}

{% block pageContent %}
	{# the case name sits inside the legend's h1 as its caption, as the layout renders it #}
	{% set legendHtml %}<span class="govuk-caption-l">{{ pageCaption }}</span>{{ pageHeading }}{% endset %}
	{# the POST runs the ruleset and the check page it redirects to can take a
	   while to load - the loading-spinner script covers both #}
	<form method="post" action="{{ formAction }}" novalidate data-loading-spinner data-loading-text="Identifying consultees">
		<input type="hidden" name="_csrf" value="{{ _csrf }}">
		{{ govukRadios({
			idPrefix: "ruleset",
			name: "ruleset",
			fieldset: {
				legend: {
					html: legendHtml,
					isPageHeading: true,
					classes: "govuk-fieldset__legend--l"
				}
			},
			errorMessage: rulesetError,
			items: rulesets
		}) }}

		{{ govukButton({
			text: "Identify consultees",
			preventDoubleClick: true
		}) }}
	</form>
{% endblock %}

{% block bodyEnd %}
	<script type="module" src="/{{ config.loadingSpinnerJs }}"></script>
{% endblock %}
