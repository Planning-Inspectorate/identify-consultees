{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{% if errorSummary %}Error: {% endif %}{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
	{% if refreshing %}
		{{ govukNotificationBanner({
			titleText: "Important",
			html: '<p class="govuk-notification-banner__heading">Refreshing cases from CBOS</p>'
				~ '<p class="govuk-body">New and changed projects will appear in a few minutes. Search again then.</p>'
		}) }}
	{% endif %}

	<form method="get" action="/">
		<div class="pins-inline-search">
			{{ govukInput({
				id: "q",
				name: "q",
				value: searchQuery,
				label: {
					text: "Find a project",
					classes: "govuk-label--m"
				},
				hint: {
					text: "Enter keyword, project reference or project title"
				},
				errorMessage: searchError,
				classes: "pins-inline-search__input",
				formGroup: {
					classes: "pins-inline-search__field govuk-!-margin-bottom-0"
				}
			}) }}
			{{ govukButton({
				text: "Search",
				classes: "pins-inline-search__button"
			}) }}
		</div>

		<input type="hidden" name="pageSize" value="{{ pageSize }}">
		{% if changingProject %}
			<input type="hidden" name="change" value="{{ changingProject.step }}">
			<input type="hidden" name="ruleset" value="{{ changingProject.rulesetId }}">
		{% endif %}
	</form>

	{# imports what is new or changed in CBOS now, rather than at the next scheduled import - then back to this search #}
	<form method="post" action="/refresh-cases" class="govuk-!-margin-top-4" novalidate>
		<input type="hidden" name="_csrf" value="{{ _csrf }}">
		{% if searchQuery %}
			<input type="hidden" name="q" value="{{ searchQuery }}">
		{% endif %}
		<input type="hidden" name="pageSize" value="{{ pageSize }}">
		{% if changingProject %}
			<input type="hidden" name="change" value="{{ changingProject.step }}">
			<input type="hidden" name="ruleset" value="{{ changingProject.rulesetId }}">
		{% endif %}
		<p class="govuk-body govuk-!-margin-bottom-2">
			Cannot find a project? Cases are imported from CBOS 5 times a day. Refresh them to get any added since.
		</p>
		{{ govukButton({
			text: "Refresh cases",
			classes: "govuk-button--secondary govuk-!-margin-bottom-0",
			preventDoubleClick: true
		}) }}
	</form>

	{% if errorSummary %}
	{% elif geometries.length %}
		<p class="govuk-body govuk-!-margin-top-6 govuk-!-margin-bottom-3">
			Showing {{ resultsFrom }} to {{ resultsTo }} of {{ resultsTotal }} results
		</p>

		{% set tableRows = [] %}
		{% for geometry in geometries %}
			{% set nameLink %}<a class="govuk-link" href="{{ geometry.href }}">{{ geometry.reference }} - {{ geometry.caseName }}</a>{% endset %}
			{% set tableRows = (tableRows.push([
				{ html: nameLink },
				{ text: geometry.stage or '' }
			]), tableRows) %}
		{% endfor %}

		{{ govukTable({
			caption: "All projects",
			captionClasses: "govuk-visually-hidden",
			firstCellIsHeader: false,
			head: [
				{ text: "Name" },
				{ text: "Stage" }
			],
			rows: tableRows
		}) }}

		{% if pagination %}
			{{ govukPagination(pagination) }}
		{% endif %}
	{% else %}
		<p class="govuk-body govuk-!-margin-top-6">No project geometries match your search.</p>
	{% endif %}
{% endblock %}
