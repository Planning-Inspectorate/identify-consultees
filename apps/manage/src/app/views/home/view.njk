{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
	<form method="get" action="/">
		{{ govukSelect({
			id: "ruleset",
			name: "ruleset",
			label: {
				text: "Choose a ruleset",
				classes: "govuk-label--m"
			},
			items: rulesets,
			value: selectedRuleset,
			classes: "govuk-!-width-one-half"
		}) }}

		<div class="pins-inline-search">
			{{ govukInput({
				id: "q",
				name: "q",
				value: searchQuery,
				label: {
					text: "Choose a project geometry",
					classes: "govuk-label--m"
				},
				hint: {
					text: "To find a specific project, search by case reference or project name"
				},
				classes: "pins-inline-search__input",
				formGroup: {
					classes: "pins-inline-search__field govuk-!-margin-bottom-0"
				}
			}) }}
			{{ govukButton({
				text: "Search",
				classes: "pins-inline-search__button"
			}) }}
		</div>

		<input type="hidden" name="pageSize" value="{{ pageSize }}">
	</form>

	{% if geometries.length %}
		<div class="govuk-!-margin-top-6 govuk-!-margin-bottom-3">
			<p class="govuk-body">
				Showing {{ resultsFrom }} to {{ resultsTo }} of {{ resultsTotal }} results
			</p>
			<p class="govuk-body">
				Results per page:
				{% for size in pageSizeOptions %}
					{% if size == pageSize %}
						<span class="govuk-!-font-weight-bold">{{ size }}</span>
					{% else %}
						<a class="govuk-link" href="/?q={{ searchQuery | urlencode }}&amp;ruleset={{ selectedRuleset | urlencode }}&amp;pageSize={{ size }}">{{ size }}</a>
					{% endif %}
					{% if not loop.last %}
						<span class="govuk-!-margin-left-1 govuk-!-margin-right-1" aria-hidden="true">|</span>
					{% endif %}
				{% endfor %}
			</p>
		</div>

		<form method="get" action="/consultees">
			<input type="hidden" name="ruleset" value="{{ selectedRuleset }}">
			<input type="hidden" name="pageSize" value="{{ pageSize }}">
			<input type="hidden" name="q" value="{{ searchQuery }}">

			{% set tableRows = [] %}
			{% for geometry in geometries %}
				{% set radioHtml %}
					{{ govukRadios({
						name: "geometryId",
						idPrefix: "geometry-" + geometry.id,
						classes: "govuk-radios--small",
						formGroup: {
							classes: "govuk-!-margin-bottom-0"
						},
						items: [{
							value: geometry.id,
							text: "Select " + geometry.reference + " version " + geometry.version,
							label: {
								classes: "govuk-visually-hidden"
							},
							checked: geometry.id == selectedGeometryId
						}]
					}) }}
				{% endset %}
				{% set tableRows = (tableRows.push([
					{ html: radioHtml },
					{ text: geometry.reference },
					{ text: geometry.caseName },
					{ text: geometry.geometryProjectStage },
					{ text: geometry.version },
					{ text: geometry.received },
					{ text: geometry.uploadedToCbos }
				]), tableRows) %}
			{% endfor %}

			{{ govukTable({
				caption: "Project geometries",
				captionClasses: "govuk-visually-hidden",
				firstCellIsHeader: false,
				head: [
					{ text: "Select", classes: "govuk-!-width-one-tenth" },
					{ text: "Reference" },
					{ text: "Case name" },
					{ text: "Geometry project stage" },
					{ text: "Version" },
					{ text: "Received", attributes: { "aria-sort": "descending" } },
					{ text: "Uploaded to C-BOS" }
				],
				rows: tableRows
			}) }}

			{{ govukButton({
				text: "Identify consultees",
				classes: "govuk-!-margin-top-2"
			}) }}
		</form>
	{% else %}
		<p class="govuk-body govuk-!-margin-top-6">No project geometries match your search.</p>
	{% endif %}
{% endblock %}
