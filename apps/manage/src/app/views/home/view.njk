{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
	{% if exampleCase %}
		{% set exampleHint %}For example, try searching for <strong>{{ exampleCase.reference }}</strong> ({{ exampleCase.caseName }}).{% endset %}
		{{ govukInsetText({
			html: exampleHint
		}) }}
	{% endif %}

	<form method="get" action="/">
		<div class="pins-inline-search">
			{{ govukInput({
				id: "q",
				name: "q",
				value: searchQuery,
				label: {
					text: "Find a project",
					classes: "govuk-label--m"
				},
				hint: {
					text: "Enter keyword, case reference or case title"
				},
				classes: "pins-inline-search__input",
				formGroup: {
					classes: "pins-inline-search__field govuk-!-margin-bottom-0"
				}
			}) }}
			{{ govukButton({
				text: "Search",
				classes: "pins-inline-search__button"
			}) }}
		</div>

		<input type="hidden" name="pageSize" value="{{ pageSize }}">
	</form>

	{% if geometries.length %}
		<div class="govuk-!-margin-top-6 govuk-!-margin-bottom-3">
			<p class="govuk-body">
				Showing {{ resultsFrom }} to {{ resultsTo }} of {{ resultsTotal }} results
			</p>
			<p class="govuk-body">
				Results per page:
				{% for size in pageSizeOptions %}
					{% if size == pageSize %}
						<span class="govuk-!-font-weight-bold">{{ size }}</span>
					{% else %}
						<a class="govuk-link" href="/?q={{ searchQuery | urlencode }}&amp;pageSize={{ size }}">{{ size }}</a>
					{% endif %}
					{% if not loop.last %}
						<span class="govuk-!-margin-left-1 govuk-!-margin-right-1" aria-hidden="true">|</span>
					{% endif %}
				{% endfor %}
			</p>
		</div>

		{% set tableRows = [] %}
		{% for geometry in geometries %}
			{% set nameLink %}<a class="govuk-link" href="/consultees/{{ geometry.id | urlencode }}">{{ geometry.reference }} - {{ geometry.caseName }}</a>{% endset %}
			{% if geometry.stage %}
				{% set stageCell = govukTag({ text: geometry.stage }) %}
			{% else %}
				{% set stageCell = "" %}
			{% endif %}
			{% set tableRows = (tableRows.push([
				{ html: nameLink },
				{ html: stageCell }
			]), tableRows) %}
		{% endfor %}

		{{ govukTable({
			caption: "All cases",
			captionClasses: "govuk-table__caption--m",
			firstCellIsHeader: false,
			head: [
				{ text: "Name" },
				{ text: "Stage" }
			],
			rows: tableRows
		}) }}

		{% if pagination %}
			{{ govukPagination(pagination) }}
		{% endif %}
	{% else %}
		<p class="govuk-body govuk-!-margin-top-6">No project geometries match your search.</p>
	{% endif %}
{% endblock %}
