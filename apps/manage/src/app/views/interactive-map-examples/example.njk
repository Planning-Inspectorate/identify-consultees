{% extends "views/layouts/main.njk" %}

{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{{ pageHeading }} - Interactive map - {{ config.headerTitle }}
{% endblock %}

{% block head %}
	{{ super() }}
	<link rel="stylesheet" href="/{{ config.vendorInteractiveMapCss }}">
	{% for stylesheet in pluginStylesheets %}
		<link rel="stylesheet" href="/{{ stylesheet }}">
	{% endfor %}
{% endblock %}

{% block pageContent %}
	<p class="govuk-body">{{ summary }}</p>

	{{ govukInsetText({ text: interaction }) }}

	<div
		id="{{ mapId }}"
		class="app-case-map app-interactive-map-example"
		role="region"
		aria-label="{{ mapRegionLabel }}"
	>
		<noscript>
			<img
				class="app-case-map-static"
				src="{{ staticMapSrc }}"
				width="{{ mapWidth }}"
				height="{{ mapHeight }}"
				alt="{{ staticMapAlt }}"
			>
		</noscript>
	</div>
	<noscript>
		<p class="govuk-body app-case-map-js-hint">
			This static image shows the same map content without JavaScript.
			The interactive version also supports the plugins listed below.
		</p>
		{% if featureLegend %}
			<h2 class="govuk-heading-m">{{ featureLegend.heading }}</h2>
			{{ govukTable({
				caption: featureLegend.heading,
				captionClasses: "govuk-visually-hidden",
				head: featureLegend.head,
				rows: featureLegend.rows
			}) }}
		{% endif %}
	</noscript>
	{% if featureLegend %}
		<div id="{{ mapId }}-fallback" class="app-map-example-fallback" hidden>
			<h2 class="govuk-heading-m">{{ featureLegend.heading }}</h2>
			{{ govukTable({
				caption: featureLegend.heading,
				captionClasses: "govuk-visually-hidden",
				head: featureLegend.head,
				rows: featureLegend.rows
			}) }}
		</div>
	{% endif %}
	<script type="application/json" id="{{ mapId }}-data">{{ mapConfigJson | safe }}</script>

	<h2 class="govuk-heading-m govuk-!-margin-top-6">About this example</h2>
	{{ govukTable({
		caption: "About this example",
		captionClasses: "govuk-visually-hidden",
		firstCellIsHeader: true,
		head: [
			{ text: "Property" },
			{ text: "Value" }
		],
		rows: [
			[{ text: "Behaviour" }, { text: behaviourLabel }],
			[{ text: "Plugins" }, { text: pluginsLabel }],
			[{ text: "Static fallback" }, { text: "AVIF, WebP or PNG (negotiated); SVG on request" }]
		]
	}) }}
{% endblock %}

{% block bodyEnd %}
	<script defer src="/{{ config.vendorInteractiveMapJs }}"></script>
	<script defer src="/{{ config.vendorMaplibreProviderJs }}"></script>
	{% for script in pluginScripts %}
		<script defer src="/{{ script }}"></script>
	{% endfor %}
	<script type="module" src="/{{ config.interactiveMapExamplesJs }}"></script>
{% endblock %}
