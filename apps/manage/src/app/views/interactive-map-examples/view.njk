{% extends "views/layouts/main.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}

{% block pageTitle %}
	{{ pageHeading }} - {{ config.headerTitle }}
{% endblock %}

{% block pageContent %}
	<p class="govuk-body">
		Worked examples of the <a class="govuk-link" href="https://defra.github.io/interactive-map/" rel="noreferrer noopener" target="_blank">Defra Interactive Map component (opens in a new tab)</a>
		as installed in this service. Each example progressively enhances: a fully
		interactive map when JavaScript and the map bundle are available, or a
		cached server-rendered static image when they are not.
	</p>

	<p class="govuk-body">
		Static maps are rendered by this service and cached with validators — the
		best format the browser accepts is negotiated automatically (AVIF, then
		WebP, then PNG). An SVG variant is also available on each example's
		<code>.svg</code> endpoint.
	</p>

	{% set tableRows = [] %}
	{% for example in examples %}
		{% set tableRows = (tableRows.push([
			{ html: '<a class="govuk-link" href="' + example.href + '">' + example.title + '</a>' },
			{ text: example.behaviourLabel },
			{ text: example.pluginsLabel }
		]), tableRows) %}
	{% endfor %}
	{{ govukTable({
		caption: "Interactive map examples",
		captionClasses: "govuk-visually-hidden",
		firstCellIsHeader: true,
		head: [
			{ text: "Example" },
			{ text: "Behaviour" },
			{ text: "Plugins" }
		],
		rows: tableRows
	}) }}
{% endblock %}
