{#
	The same footer markup as core's pinsFooter macro, minus target="_blank" - ours link to pages
	inside this service, which should open in the same tab.
#}
{% macro appFooter(footerLinks) %}
	<footer class="pins-footer">
		<div class="pins-footer-row">
			<div class="pins-footer-container govuk-width-container">
				<div class="govuk-footer__meta">
					<div class="govuk-footer__meta-item">
						{% if footerLinks | length %}
							<h2 class="govuk-visually-hidden">Support links</h2>
							<ul class="govuk-footer__inline-list">
								{% for footerLink in footerLinks %}
									<li class="govuk-footer__inline-list-item">
										<a class="govuk-footer__link" href="{{ footerLink.link }}">{{ footerLink.text }}</a>
									</li>
								{% endfor %}
							</ul>
						{% endif %}
					</div>
					<div class="govuk-footer__meta-item">
						<span class="govuk-footer__copyright">© Planning Inspectorate</span>
					</div>
				</div>
			</div>
		</div>
	</footer>
{% endmacro %}
