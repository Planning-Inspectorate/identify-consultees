{% from "ui/header/pins-header.njk" import pinsHeader %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{#
  PINS branded chrome shared by all manage pages.

  Header: `pinsHeader` from @planning-inspectorate/core (internal variant).
  Styles come from core's ui/header/pins-header.scss via govuk-overrides.scss.

  Navigation: GOV.UK Frontend `govukServiceNavigation`.
#}

{% macro pinsServiceHeader() %}
	{{ pinsHeader({ isExternal: false }) }}
{% endmacro %}

{% macro pinsServiceNavigation(serviceName, hideSignOut = false, showComponents = false) %}
	{% set navigationItems = [
		{
			href: "/",
			text: "Home",
			active: not hideSignOut
		}
	] %}

	{% if showComponents %}
		{% set navigationItems = (navigationItems.push({
			href: "/components?components=true",
			text: "Components"
		}), navigationItems) %}
	{% endif %}

	{% if not hideSignOut %}
		{% set navigationItems = (navigationItems.push({
			href: "/auth/signout",
			text: "Sign out"
		}), navigationItems) %}
	{% endif %}

	{{ govukServiceNavigation({
		serviceName: serviceName,
		serviceUrl: "/",
		classes: "pins-service-navigation",
		navigation: navigationItems
	}) }}
{% endmacro %}
