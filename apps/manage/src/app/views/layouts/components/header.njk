{% from "ui/header/pins-header.njk" import pinsHeader %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{#
  PINS branded chrome shared by all manage pages.

  Header: `pinsHeader` from src/lib/ui (internal variant).
  Styles come from src/lib/ui/header/pins-header.scss via govuk-overrides.scss.

  Navigation: GOV.UK Frontend `govukServiceNavigation`.
#}

{% macro pinsServiceHeader() %}
	{{ pinsHeader({ isExternal: false }) }}
{% endmacro %}

{#
  adminLink: { href, active } when the admin section is mounted (admin/index.ts sets it) - its
  header link, active on the admin pages.
#}
{% macro pinsServiceNavigation(serviceName, hideSignOut = false, showComponents = false, adminLink = undefined) %}
	{% set navigationItems = [
		{
			href: "/",
			text: "Home",
			active: not hideSignOut and not (adminLink and adminLink.active)
		}
	] %}

	{% if adminLink %}
		{% set navigationItems = (navigationItems.push({
			href: adminLink.href,
			text: "Admin",
			active: adminLink.active
		}), navigationItems) %}
	{% endif %}

	{% if showComponents %}
		{% set navigationItems = (navigationItems.push({
			href: "/components?components=true",
			text: "Components"
		}), navigationItems) %}
	{% endif %}

	{% if not hideSignOut %}
		{% set navigationItems = (navigationItems.push({
			href: "/auth/signout",
			text: "Sign out"
		}), navigationItems) %}
	{% endif %}

	{{ govukServiceNavigation({
		serviceName: serviceName,
		serviceUrl: "/",
		classes: "pins-service-navigation",
		navigation: navigationItems
	}) }}
{% endmacro %}
