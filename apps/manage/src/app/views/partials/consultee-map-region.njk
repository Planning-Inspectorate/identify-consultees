{#
  Progressive-enhancement map region (ported from PINS-data-spike case-map-region).
  Requires: mapId, mapRegionLabel, staticMapSrc, staticMapAlt, mapWidth, mapHeight, mapConfigJson
#}
{# the InteractiveMap constructor JSON.parses every data-* attribute on its container -
   the fallback details travel in the JSON config block instead, and the container is
   discovered by class, not data-* #}
<div
	id="{{ mapId }}"
	class="app-case-map app-consultee-map"
	role="region"
	aria-label="{{ mapRegionLabel }}"
>
	<noscript>
		<img
			class="app-case-map-static"
			src="{{ staticMapSrc }}"
			width="{{ mapWidth }}"
			height="{{ mapHeight }}"
			alt="{{ staticMapAlt }}"
		>
	</noscript>
</div>
<noscript>
	<p class="govuk-body app-case-map-js-hint">
		This static map shows the same project site and consultee areas without JavaScript.
	</p>
</noscript>

<script type="application/json" id="{{ mapId }}-data">{{ mapConfigJson | safe }}</script>
