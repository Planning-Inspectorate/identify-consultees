{
  "name": "identify-consultees",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "check-types": "npx tsc -p tsconfig.check.json",
    "commitlint": "commitlint --from=$(git rev-parse $(git cherry origin/main | head -n 1 | cut -c 3-)^1)",
    "db-migrate-dev": "npm run migrate-dev --workspace @pins/identify-consultees-database",
    "db-migrate-prod": "npm run migrate-prod --workspace @pins/identify-consultees-database",
    "db-generate": "npm run generate --workspace @pins/identify-consultees-database",
    "db-seed": "npm run seed --workspace @pins/identify-consultees-database",
    "db-seed-prod": "npm run seed-prod --workspace @pins/identify-consultees-database",
    "deps:patch-maplibre": "node --experimental-strip-types scripts/patch-maplibre-sanitize.ts",
    "format": "npm run format-prettier && npm run format-css",
    "format-css": "stylelint \"**/*.{css,scss}\" --fix",
    "format-prettier": "prettier --write .",
    "format-prettier-check": "prettier --check .",
    "lint": "npm run lint-ts && npm run lint-css",
    "lint-css": "stylelint \"**/*.{css,scss}\"",
    "lint-ts": "npx eslint .",
    "prepare": "node .husky/install.mjs",
    "postinstall": "npm run deps:patch-maplibre",
    "start": "node scripts/start-local.mjs",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.13.3",
    "@azure/msal-node": "^6.0.0",
    "@defra/interactive-map": "^0.0.42-fmp-5",
    "@planning-inspectorate/core": "^1.11.0",
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@redis/entraid": "^6.2.1",
    "@types/lusca": "^1.7.5",
    "accessible-autocomplete": "^3.0.1",
    "body-parser": "^2.3.0",
    "connect-redis": "^10.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "govuk-frontend": "^6.5.1",
    "helmet": "^8.3.0",
    "lusca": "^1.7.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@planning-inspectorate/coding-standards": "^1.2.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/old": "npm:typescript@^6.0.3",
    "axe-core": "^4.13.0",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.10.0",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "supertest": "^7.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.{js,ts,json,md,prisma,yml,yaml,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "mysql2": "^3.22.0",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "@humanfs/node": "^0.16.8",
    "maplibre-gl": "6.6.0"
  }
}
