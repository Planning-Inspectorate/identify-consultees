{
  "name": "@pins/identify-consultees-database",
  "version": "0.0.0",
  "description": "Common sql database access",
  "private": true,
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "migrate-dev": "npx prisma migrate dev",
    "migrate-prod": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "seed": "npm run generate && npx prisma db seed",
    "seed-prod": "npm run generate && node src/seed/seed-prod.ts",
    "import": "npm run generate && node src/seed/import-cli.ts",
    "import-from-blob": "npm run generate && node src/seed/import-from-blob.ts",
    "promote-reference-data": "npm run generate && node src/seed/promote-reference-data.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "*",
    "@azure/storage-blob": "*",
    "@prisma/adapter-mssql": "*",
    "@prisma/client": "*",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "prisma": "*"
  }
}
